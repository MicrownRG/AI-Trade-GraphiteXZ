# ── MT5 credentials ────────────────────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=ICMarketsSC-Raw
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# ── Database ───────────────────────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://trader:trader@localhost:5432/trading_db
DB_ECHO=false

# ── AI Provider ────────────────────────────────────────────────────────────────
# Options: deepseek (default) | anthropic | gemini
AI_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat          # deepseek-chat | deepseek-reasoner

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-5       # claude-opus-4-5 | claude-sonnet-4-5 | claude-haiku-4-5-20251001

# Google Gemini
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash         # gemini-2.0-flash | gemini-1.5-pro

# ── System ─────────────────────────────────────────────────────────────────────
RUN_MODE=backtest
LOG_LEVEL=INFO

# ── Telegram ───────────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram chat ID (get it from @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Optional: allow additional chat IDs (comma-separated)
TELEGRAM_ALLOWED_CHAT_IDS=

# Loss guard settings
TELEGRAM_LOSS_PAUSE_MINUTES=60
TELEGRAM_CONSECUTIVE_LOSS_TRIGGER=3
TELEGRAM_DAILY_LOSS_PCT_TRIGGER=2.0
